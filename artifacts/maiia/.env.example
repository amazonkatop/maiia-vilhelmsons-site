# Copy to artifacts/maiia/.env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Port the SSR server listens on.
PORT=5173
# Base path if served under a subpath (usually just "/").
BASE_PATH=/

# Where the SSR server (Node, never exposed to the browser) reaches the API.
API_BASE_URL=http://localhost:8080
# Where the BROWSER reaches the API — must have the VITE_ prefix or Vite
# will not expose it to client-side code. In production this is your
# public API domain (e.g. https://api.maiiavilhelmsons.com), not localhost.
VITE_API_BASE_URL=http://localhost:8080

# Used for canonical URLs, sitemap.xml and JSON-LD.
# TODO: set to the real production domain once one is chosen.
SITE_ORIGIN=https://maiiavilhelmsons.com
