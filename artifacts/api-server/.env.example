# Copy to artifacts/api-server/.env and fill in real values.
# .env is git-ignored — never commit real secrets.

PORT=8080

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# --- Supabase Storage (photos) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret — never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# --- Email (Resend, for the consultation form) ---
RESEND_API_KEY=

# --- Auth (admin/editor login) ---
SESSION_SECRET=change-me-to-a-random-string
# Comma-separated list of frontend origins allowed to call this API
# with credentials (cookies). Must match exactly, including protocol.
CORS_ORIGIN=http://localhost:5173
